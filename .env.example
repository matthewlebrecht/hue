# Copy to .env.local and fill in. .env* is gitignored (except this file).
# Supabase project: Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=paste-anon-public-key-here

# Weather (Open-Meteo — no API key needed). Defaults to Salt Lake City.
VITE_WEATHER_LAT=40.7256
VITE_WEATHER_LON=-111.8834
VITE_WEATHER_PLACE=Salt Lake City
